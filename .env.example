# Only data access and email delivery are configured here.
NEWS_API_KEY=
NEWS_API_URL=https://v3.alapi.cn/api/zaobao
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Multiple recipient addresses are separated by commas.
EMAIL_RECIPIENT=
SMTP_HOST=smtp.163.com
SMTP_PORT=25
SMTP_SECURITY=starttls
SQLITE_DB_PATH=data/daily-news.db
REPORT_DIR=data/reports
TIMEZONE=Asia/Shanghai
HISTORY_DAYS=30
HTTP_RETRIES=3
# Timeout in seconds for both news HTTP requests and SMTP connections.
HTTP_TIMEOUT=30
